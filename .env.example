# ============================================================================
# Mercedes Scientific Natural Language Search - Environment Variables
# ============================================================================
# This file documents all environment variables used across the system.
# Copy to .env and fill in your values.
#
# Architecture:
#   - Frontend (Vercel): Next.js app at mercedes-nl-search.vercel.app
#   - Backend API (Railway): FastAPI server for search endpoints
#   - Middleware (Railway): OpenAI-compatible RAG middleware for query processing
#   - Indexer (Local): Scripts to index products into Typesense
# ============================================================================


# ============================================================================
# FRONTEND (Vercel) - frontend-next/
# ============================================================================
# These variables are used by the Next.js frontend deployed on Vercel.
# Set these in Vercel's Environment Variables dashboard.

# Backend API URL (points to Railway backend)
NEXT_PUBLIC_API_URL=https://mercedes-nl-search-production.up.railway.app

# Environment identifier for frontend
NEXT_PUBLIC_ENVIRONMENT=production


# ============================================================================
# BACKEND API (Railway) - src/app.py
# ============================================================================
# These variables are used by the FastAPI backend deployed on Railway.
# Set these in Railway's Variables tab for the backend service.

# --- Typesense Configuration ---
TYPESENSE_HOST=your-typesense-host.a1.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your-typesense-admin-api-key
TYPESENSE_COLLECTION_NAME=mercedes_products

# --- Natural Language Search ---
NL_MODEL_ID=middleware-rag-vllm  # Registered model ID in Typesense

# --- Server Configuration ---
ENVIRONMENT=production           # Environment: development, staging, production
SERVER_PORT=5001                 # Port for FastAPI server (Railway sets PORT automatically)

# Note: Backend does NOT need OPENAI_* variables - middleware handles LLM calls
# Note: Backend does NOT need NEON_DATABASE_URL - indexer runs locally, not on backend


# ============================================================================
# MIDDLEWARE (Railway) - src/openai_middleware.py
# ============================================================================
# These variables are used by the RAG middleware deployed on Railway.
# Set these in Railway's Variables tab for the middleware service.
# Deployed at: https://web-production-a5d93.up.railway.app

# --- OpenAI Configuration (for RAG classification) ---
# Middleware uses GPT-4o-mini for category classification
# Note: OPENAI_MODEL is NOT needed - model comes from Typesense request
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Typesense Configuration (for RAG retrieval) ---
# Middleware queries Typesense to retrieve product context for classification
TYPESENSE_HOST=your-typesense-host.a1.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your-typesense-search-only-api-key
TYPESENSE_COLLECTION_NAME=mercedes_products  # Collection to query for RAG context

# --- Cache Configuration (JAI-2169: LLM Query Caching) ---
# Mode: langcache (recommended), diy (self-hosted Redis), disabled
CACHE_MODE=langcache

# LangCache Configuration (recommended for production)
# Get these values from Redis Cloud LangCache dashboard
LANGCACHE_API_URL=https://aws-us-east-1.langcache.redis.io
LANGCACHE_CACHE_ID=your_cache_id_here
LANGCACHE_API_KEY=your_langcache_api_key_here

# DIY Redis Configuration (alternative to LangCache)
# Use CACHE_MODE=diy to enable
# REDIS_URL=redis://your-redis-host:6379
# REDIS_CACHE_TTL=3600                  # Cache TTL in seconds (default: 1 hour)
# CACHE_SIMILARITY_THRESHOLD=0.95       # Semantic similarity threshold (0.0-1.0)


# ============================================================================
# INDEXER (Local) - src/indexer_neon.py, src/indexer.py
# ============================================================================
# These variables are used by indexing scripts run locally (not deployed).
# Only needed when re-indexing the product catalog.

# --- OpenAI Configuration (for embedding generation) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Typesense Configuration (same as backend) ---
# Indexer needs write access to Typesense
TYPESENSE_HOST=your-typesense-host.a1.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your-typesense-admin-api-key
TYPESENSE_COLLECTION_NAME=mercedes_products  # Collection to create/update

# --- Neon Database (RECOMMENDED for indexing) ---
# Get connection string from Neon console
NEON_DATABASE_URL=postgresql://journey_user:your-password@your-host.neon.tech/neondb?sslmode=require

# --- Magento Database (Alternative: direct MySQL access) ---
MAGENTO_DB_HOST=your-magento-db-host.com
MAGENTO_DB_PORT=3306
MAGENTO_DB_NAME=magento_database_name
MAGENTO_DB_USER=magento_user
MAGENTO_DB_PASSWORD=your-magento-db-password

# --- Mercedes GraphQL API (LEGACY - not recommended) ---
# Limited to 5,000-10,000 products due to API pagination limits
MERCEDES_GRAPHQL_URL=https://www.mercedesscientific.com/graphql


# ============================================================================
# LOCAL DEVELOPMENT
# ============================================================================
# When running locally, you may want to use these settings:

# ENVIRONMENT=development
# SERVER_PORT=5001
# NEXT_PUBLIC_API_URL=http://localhost:5001

# For local Redis (Docker):
# docker run -d -p 6379:6379 redis:alpine
# REDIS_URL=redis://localhost:6379


# ============================================================================
# BACKWARD COMPATIBILITY (Deprecated)
# ============================================================================
# These variables are deprecated but still supported for existing deployments:
# FLASK_ENV=development    → Use ENVIRONMENT instead
# FLASK_PORT=5001          → Use SERVER_PORT instead
