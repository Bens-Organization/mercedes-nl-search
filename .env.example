# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini-2024-07-18
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Typesense Configuration
TYPESENSE_HOST=your-typesense-host.a1.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your-typesense-admin-api-key

# Mercedes GraphQL API (legacy - not used with Neon indexer)
MERCEDES_GRAPHQL_URL=https://www.mercedesscientific.com/graphql

# Neon Database (for indexing - get from Neon console)
NEON_DATABASE_URL=postgresql://journey_user:your-password@your-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Server Configuration
ENVIRONMENT=development    # Environment: development, staging, production
SERVER_PORT=5001           # Port for FastAPI server

# Redis Cache Configuration (JAI-2169: LLM Query Caching)
# Mode: auto (try LangCache → DIY → disabled), langcache (LangCache only), diy (DIY only), disabled (no cache)
CACHE_MODE=diy

# DIY Redis Configuration (when using diy or auto mode)
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600  # Cache TTL in seconds (default: 1 hour)
CACHE_SIMILARITY_THRESHOLD=0.95  # Semantic similarity threshold (0.0-1.0)

# Redis LangCache REST API (when available in private preview)
# Get these values from Redis Cloud LangCache dashboard
# LANGCACHE_API_URL=https://aws-us-east-1.langcache.redis.io
# LANGCACHE_CACHE_ID=your_cache_id_here
# LANGCACHE_API_KEY=your_langcache_api_key_here

# Backward Compatibility (deprecated, but still supported)
# If you have existing deployments, you can keep using:
# FLASK_ENV=development
# FLASK_PORT=5001
