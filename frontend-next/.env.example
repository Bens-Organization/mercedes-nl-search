# Frontend Environment Variables

# API URL - Update with your deployed backend URL
NEXT_PUBLIC_API_URL=http://localhost:5001

# For production deployment, use:
# Vercel (recommended - no cold starts):
# NEXT_PUBLIC_API_URL=https://your-backend-project.vercel.app
#
# Render (legacy - has cold starts):
# NEXT_PUBLIC_API_URL=https://your-backend-url.onrender.com

# Environment - Controls debug information visibility
# - 'development': Shows query details and timing information (default)
# - 'demo' or 'production': Hides query details and timing for cleaner UI
NEXT_PUBLIC_ENVIRONMENT=development
